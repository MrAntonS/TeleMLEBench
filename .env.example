# Hash one or more evaluation API keys with SHA-256 and separate digests by commas.
TMLB_EVALUATION_API_KEY_SHA256S=

# Cloudflare Turnstile protects browser uploads. The site key is public; the
# secret and evaluation-grant signing secret must remain server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=mrantons.github.io
TMLB_EVALUATION_GRANT_SECRET=

# Read access to NextGLab/telemlebench-evaluator. Never expose this to the browser.
HF_TOKEN=

# Added automatically when a private Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
