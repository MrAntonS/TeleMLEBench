 +        depth=6,                                                              
 +        loss_function='Logloss',                                              
 +        verbose=False,                                                        
 +        random_seed=42                                                        
 +    )                                                                         
 +    model.fit(X_train, y_train)                                               
 +                                                                              
 +    # 6. Evaluation                                                           
 +    y_pred = model.predict(X_test)                                            
