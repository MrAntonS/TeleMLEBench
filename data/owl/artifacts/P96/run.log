 +class ComplexConv2d(nn.Module):                                               
 +    """                                                                       
 +    Implements complex convolution using real-valued convolutions.            
 +    Input: (N, C_in, H, W) where C_in is even (I/Q interleaved or separate).  
 +    We assume input is (N, 2*C, H, W) where first C are Real, next C are      
 Imag.                                                                          
 +    Output: (N, 2*C_out, H, W)                                                
 +    """                                                                       
 +    def __init__(self, in_channels, out_channels, kernel_size, stride=1,      
 padding=0, bias=True):                                                         
 +        super(ComplexConv2d, self).__init__()                                 
 +        # in_channels and out_channels are the number of complex channels.    
 +        # Actual real channels are 2 * in_channels and 2 * out_channels.      
 +        self.in_channels = in_channels                                        
 +        self.out_channels = out_channels                                      
 +        self.kernel_size = kernel_size                                        
 +        self.stride = stride                                                  
 +        self.padding = padding                                                
 +                                                                              
 +        # We need 4 conv layers:                                              
 +        # 1. Real input * Real kernel -> Real output                          
 +        # 2. Real input * Imag kernel -> Imag output                          
 +        # 3. Imag input * Real kernel -> Imag output                          
 +        # 4. Imag input * Imag kernel -> Real output (with negative sign)     
 +                                                                              
 +        # To save memory and compute, we can use a single conv layer with 4 * 
 out_channels filters                                                           
 +        # and split the input into Real and Imag parts.                       
 +                                                                              
 +        # Input shape: (N, 2*C_in, H, W)                                      
 +        # We split into X_r (N, C_in, H, W) and X_i (N, C_in, H, W)           
 +                                                                              
 +        # Kernel shape: (4*C_out, C_in, K, K)                                 
 +        # The 4 groups correspond to:                                         
 +        # Group 0: H_r (Real part of kernel)                                  
 +        # Group 1: H_i (Imag part of kernel)                                  
 +        # Group 2: H_r (Real part of kernel, for Imag input)                  
 +        # Group 3: H_i (Imag part of kernel, for Imag input)                  
 +                                                                              
 +        # Actually, it's simpler to just have 4 separate conv layers or one   
 conv layer that takes concatenated input.                                      
 +        # Let's use one conv layer with 4 * out_channels filters.             
 +        # Input to this conv: (N, 2 * C_in, H, W)                             
 +        # We need to map (2 * C_in) to (4 * C_out).                           
 +                                                                              
 +        self.conv = nn.Conv2d(2 * in_channels, 4 * out_channels, kernel_size, 
 stride, padding, bias=bias)                                                    
 +                                                                              
 +    def forward(self, x):                                                     
 +        # x: (N, 2*C_in, H, W)                                                
 +        N, C2, H, W = x.shape                                                 
 +        C_in = C2 // 2                                                        
 +                                                                              
 +        # Split into Real and Imag                                            
 +        x_r = x[:, :C_in, :, :]                                               
 +        x_i = x[:, C_in:, :, :]                                               
 +                                                                              
 +        # Perform convolution                                                 
 +        # Output will be (N, 4*C_out, H', W')                                 
 +        out = self.conv(x)                                                    
 +                                                                              
 +        # Split output into 4 parts                                           
 +        out_r_r = out[:, :self.out_channels, :, :] # Real in, Real kernel     
 +        out_r_i = out[:, self.out_channels:2*self.out_channels, :, :] # Real  
 in, Imag kernel                                                                
 +        out_i_r = out[:, 2*self.out_channels:3*self.out_channels, :, :] #     
 Imag in, Real kernel                                                           
 +        out_i_i = out[:, 3*self.out_channels:, :, :] # Imag in, Imag kernel   
 +                                                                              
 +        # Complex multiplication:                                             
 +        # Y_r = X_r * H_r - X_i * H_i  => out_r_r - out_i_i                   
 +        # Y_i = X_r * H_i + X_i * H_r  => out_r_i + out_i_r                   
 +                                                                              
 +        y_r = out_r_r - out_i_i                                               
 +        y_i = out_r_i + out_i_r                                               
 +                                                                              
 +        # Concatenate back to (N, 2*C_out, H', W')                            
 +        y = torch.cat([y_r, y_i], dim=1)                                      
 +                                                                              
 +        return y                                                              
 +                                                                              
 +class BasicBlock(nn.Module):                                                  
 +    expansion = 1                                                             
 +                                                                              
 +    def __init__(self, in_planes, planes, stride=1, complex_conv=True):       
 +        super(BasicBlock, self).__init__()                                    
 +        self.complex_conv = complex_conv                                      
 +        if complex_conv:                                                      
 +            self.conv1 = ComplexConv2d(in_planes, planes, kernel_size=3,      
 stride=stride, padding=1, bias=False)                                          
 +            self.conv2 = ComplexConv2d(planes, planes, kernel_size=3,         
 stride=1, padding=1, bias=False)                                               
 +        else:                                                                 
 +            self.conv1 = nn.Conv2d(in_planes, planes, kernel_size=3,          
 stride=stride, padding=1, bias=False)                                          
 +            self.conv2 = nn.Conv2d(planes, planes, kernel_size=3, stride=1,   
 padding=1, bias=False)                                                         
 +                                                                              
 +        self.bn1 = nn.BatchNorm2d(planes * 2 if complex_conv else planes)     
 +        self.bn2 = nn.BatchNorm2d(planes * 2 if complex_conv else planes)     
 +                                                                              
 +        self.shortcut = nn.Sequential()                                       
 +        if stride != 1 or in_planes != self.expansion * planes:               
 +            if complex_conv:                                                  
 +                # Shortcut needs to match complex channel count               
 +                self.shortcut = nn.Sequential(                                
 +                    ComplexConv2d(in_planes, self.expansion * planes,         
 kernel_size=1, stride=stride, bias=False),                                     
 +                    nn.BatchNorm2d(self.expansion * planes * 2)               
 +                )                                                             
 +            else:                                                             
 +                self.shortcut = nn.Sequential(                                
 +                    nn.Conv2d(in_planes, self.expansion * planes,             
 kernel_size=1, stride=stride, bias=False),                                     
 +                    nn.BatchNorm2d(self.expansion * planes)                   
 +                )                                                             
 +                                                                              
 +    def forward(self, x):                                                     
 +        out = F.relu(self.bn1(self.conv1(x)))                                 
 +        out = self.bn2(self.conv2(out))                                       
 +        out += self.shortcut(x)                                               
 +        out = F.relu(out)                                                     
 +        return out                                                            
