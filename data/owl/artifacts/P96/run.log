 +                                                                              
 +        layers.append(block(current_in, plane, stride, complex_conv))         
 +        if complex_conv:                                                      
 +            self.in_planes = plane * 2                                        
 +        else:                                                                 
 +            self.in_planes = plane                                            
 +        for _ in range(1, num_blocks):                                        
 +            layers.append(block(self.in_planes, plane, 1, complex_conv))      
 +        return nn.Sequential(*layers)                                         
 +                                                                              
 +    def forward(self, x):                                                     
 +        out = self.bn1(self.conv1(x))                                         
 +        out = F.relu(out)                                                     
 +        out = self.maxpool(out)                                               
