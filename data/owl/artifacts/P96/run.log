 +            self.avgpool = nn.AdaptiveAvgPool2d((1, 1))                       
 +            self.fc = nn.Linear(in_planes * 8, 11)                            
 +                                                                              
 +    def _make_layer(self, block, plane, num_blocks, stride, complex_conv):    
 +        downsample = None                                                     
 +        layers = []                                                           
 +        if complex_conv:                                                      
 +            in_planes = self.in_planes                                        
 +        else:                                                                 
 +            in_planes = self.in_planes                                        
 +                                                                              
 +        # Note: self.in_planes is updated in forward, but for init we need to 
 track it                                                                       
