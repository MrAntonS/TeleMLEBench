{
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"],
    "plugins": [{ "name": "workflow" }]
  },
  "include": [
    "server/**/*.ts",
    "workflows/**/*.ts",
    "vite.config.ts",
    "vercel.ts"
  ]
}
